# ---- Sign-in (change these before going live) ----
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@123
# Long random string; keeps people signed in across restarts
SESSION_SECRET=
SESSION_HOURS=12
PORT=3000
# Where reports, settings and keys are stored (mount a volume here in Docker)
DATA_DIR=./data

# ---- Optional: set keys here instead of in the Settings screen ----
# Anything set here is locked in the Settings screen.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=accounts@urjaproducts.com
# SMTP_PASS=your-app-password
# WA_PHONE_NUMBER_ID=123456789012345
# WA_API_VERSION=v21.0
# WA_TOKEN=EAAG...
# OMNIDIM_API_KEY=...

# ---- Optional: Microsoft Dynamics 365 Business Central ----
# BC_TENANT_ID=00000000-0000-0000-0000-000000000000
# BC_ENVIRONMENT=Production
# BC_COMPANY=URJA-LIVE
# BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# BC_CLIENT_SECRET=...
# BC_LEDGER_SERVICE=CustomerLedgerEntries
# BC_FILTER=Customer_Posting_Group eq 'CNI'
# BC_SYNC_CUSTOMERS=true
